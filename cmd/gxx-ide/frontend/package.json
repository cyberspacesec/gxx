{
  "name": "gxx-ide-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "preview": "vite preview",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "format": "prettier --write \"src/**/*.{ts,vue,json,css,scss}\"",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@shikijs/monaco": "^4.6.0",
    "axios": "^1.21.1",
    "monaco-editor": "^0.57.0",
    "pinia": "^4.1.0",
    "shiki": "^4.6.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.6",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "prettier": "^3.10.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "minimatch": "^11.0.8"
  }
}
